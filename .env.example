# Copy to .env next to compose.yaml and adjust. .env is ignored by git:
# keep real keys there, never in this file.

# Host user and group that own data, downloads and the media library
# (`id -u` and `id -g` on the host).
PUID=1000
PGID=1000

# HOST_* settings are read by Docker Compose, not by Direkt: they choose
# what on the host is mounted into the container (see compose.yaml).

# Host port for the web UI and API.
HOST_PORT=9877

# Host directories. Create them before the first start, owned by PUID:PGID;
# Compose will not start with one missing. Names are case-sensitive, and a
# path may contain spaces (no quotes needed). Direkt only sees them at their
# container paths, shown on the right.
HOST_DATA_DIR=./data                  # /data
HOST_DOWNLOADS_DIR=./downloads        # /downloads
# Media library folders, the ones Jellyfin or Plex scan. For example
# HOST_TV_DIR=/srv/media/TV Shows
HOST_MOVIES_DIR=./media/movies        # /media/movies
HOST_TV_DIR=./media/tv                # /media/tv
HOST_UNSORTED_DIR=./media/unsorted    # /media/unsorted (unidentified videos)

# DIREKT_* settings are passed to Direkt.
# Optional. Setting a key here locks it on the Settings page.
DIREKT_ONEFICHIER_API_KEY=
DIREKT_TMDB_API_KEY=
